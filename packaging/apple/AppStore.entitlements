<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build (App Sandbox). CI adds com.apple.application-identifier
     and com.apple.developer.team-identifier at signing time to match the
     provisioning profile. The PR smoke test signs ad hoc with this file as is. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Data feeds, DX cluster/HamAlert telnet, rigctld, gpsd, Meshtastic. -->
    <key>com.apple.security.network.client</key><true/>
    <!-- Optional WSJT-X / N1MM UDP spot listener (binds a local port). -->
    <key>com.apple.security.network.server</key><true/>
    <!-- ADIF log picked in the open panel, kept across launches by a bookmark. -->
    <key>com.apple.security.files.user-selected.read-only</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
</dict>
</plist>
