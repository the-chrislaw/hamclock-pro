#!/bin/sh
# Opt-in updater (timer is NOT enabled in the image): installs the newest STABLE HamClock Pro release .deb for this
# OS release/arch from GitHub Releases, only if the release's SHA256SUMS asset lists it and the checksum matches.
# Pre-releases (the rolling build) are never installed. Only github.com is contacted; nothing is sent beyond an
# honest User-Agent. The previous .deb is kept in /var/lib/hamclock-pro-update and reinstalled if the new one fails.
# Note: SHA256SUMS comes from the same release as the .deb, so this detects corruption, not a hostile publisher;
# detached-signature verification needs a signing key (see docs/install-pi.md).
set -eu
repo=the-chrislaw/hamclock-pro
arch=$(dpkg --print-architecture)
rel=$(. /etc/os-release; echo "$VERSION_CODENAME")
ua="hamclock-pro-update (+https://github.com/$repo)"
keep=/var/lib/hamclock-pro-update
json=$(curl -fsSL -A "$ua" "https://api.github.com/repos/$repo/releases/latest")  # latest = newest non-pre-release
assets=$(printf '%s\n' "$json" | grep -o '"browser_download_url": *"[^"]*"' | sed 's/^[^:]*: *"//; s/"$//')
url=$(printf '%s\n' "$assets" | grep "/[^/]*_${rel}_${arch}\.deb\$" | head -n1 || true)
sums=$(printf '%s\n' "$assets" | grep '/SHA256SUMS$' | head -n1 || true)
[ -n "$url" ] || { echo "no stable release .deb for $rel/$arch"; exit 0; }
[ -n "$sums" ] || { echo "release has no SHA256SUMS; not installing"; exit 1; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
name=$(basename "$url")
curl -fsSL -A "$ua" -o "$tmp/$name" "$url"
curl -fsSL -A "$ua" -o "$tmp/SHA256SUMS" "$sums"
want=$(awk -v n="$name" '{f=$2; sub(/^\*/,"",f); if (f==n) print $1}' "$tmp/SHA256SUMS" | head -n1)
have=$(sha256sum "$tmp/$name" | cut -d' ' -f1)
[ -n "$want" ] && [ "$want" = "$have" ] || { echo "checksum mismatch or missing for $name; not installing"; exit 1; }
new=$(dpkg-deb -f "$tmp/$name" Version)
cur=$(dpkg-query -W -f='${Version}' hamclock-pro 2>/dev/null || true)
[ "$new" != "$cur" ] || exit 0
mkdir -p "$keep"
if [ -n "$cur" ] && [ -f "$keep/current.deb" ]; then mv -f "$keep/current.deb" "$keep/previous.deb"; fi
if apt-get install -y "$tmp/$name"; then
  cp -f "$tmp/$name" "$keep/current.deb"
  systemctl restart hamclock-kiosk.service
else
  echo "install failed; rolling back"
  [ -f "$keep/previous.deb" ] && apt-get install -y --allow-downgrades "$keep/previous.deb" || true
  systemctl restart hamclock-kiosk.service || true
  exit 1
fi
