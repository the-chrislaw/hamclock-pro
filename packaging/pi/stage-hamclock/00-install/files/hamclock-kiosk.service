[Unit]
Description=HamClock Pro kiosk
# Not after network-online.target: with no Wi-Fi that waits for its timeout on a blank screen;
# the app starts offline and its feeds retry on their own.
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=hamclock
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/local/bin/hamclock-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
